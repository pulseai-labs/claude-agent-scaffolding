{
  "version": 1,
  "name": "ossify-spine",
  "params": ["spine", "spine_branch", "spine_dir", "ai_root", "ai_project", "repo", "project", "state_file", "oss", "briefs", "via"],
  "slots": { "session": 2, "build": 1 },
  "sources": [
    {
      "dir": "{run.dir}/queue",
      "id_key": "work_item_id",
      "group_key": "round",
      "order_key": "order",
      "vars": { "worktree_path": "worktree_path", "branch": "branch", "handoff_path": "handoff_path", "base_sha": "base_sha" },
      "stage": "implement"
    },
    {
      "dir": "{run.dir}/spine",
      "id_key": "id",
      "group_key": "group",
      "order_key": "order",
      "vars": { "pr_url": "pr_url" },
      "stage": "spine_review"
    }
  ],
  "seed": [{ "id": "lane", "stage": "lane" }],
  "triage": {
    "kind": "triage",
    "instance": "OMP_Seat",
    "model": "default",
    "project": "{param.ai_project}",
    "cwd": "{param.ai_root}",
    "launch_dir": "worktree",
    "title": "triage {unit.id}",
    "message": "Read {param.briefs}/triage.md and follow it. Stuck thread: {pending.thread}. Stage: {pending.stage}. Run: {run.id}. Unit: {unit.id}. Request: {pending.request}. Questions: {pending.questions}. Note file: {run.dir}/out/{unit.id}/triage-note.md. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
    "env": {
      "SEAT_MODS_ROLE": "orchestrator",
      "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
      "OMP_T3_VIA": "{param.via}",
      "OMP_T3_SEAT": "worker",
      "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
      "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
    },
    "stall_minutes": 10,
    "note_file": "{run.dir}/out/{unit.id}/triage-note.md"
  },
  "driver": {
    "kind": "driver",
    "instance": "OMP_Seat",
    "model": "default",
    "project": "{param.ai_project}",
    "cwd": "{param.ai_root}",
    "launch_dir": "worktree",
    "title": "driver {unit.id}",
    "message": "Read {param.briefs}/driver.md and follow it. Unit: {unit.id}. Parked in: {driver.stage}. Reason: {driver.reason}. State file: {run.dir}/out/{unit.id}/driver-state.md. Result file: {run.dir}/out/{unit.id}/driver-result-{driver.launch}.json. Briefs: {param.briefs}. Spine: {param.spine_dir}.",
    "env": {
      "SEAT_MODS_ROLE": "reviewer",
      "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
      "OMP_T3_VIA": "{param.via}",
      "OMP_T3_SEAT": "worker"
    },
    "stall_minutes": 15,
    "state_file": "{run.dir}/out/{unit.id}/driver-state.md",
    "result_file": "{run.dir}/out/{unit.id}/driver-result-{driver.launch}.json",
    "ledger": "{param.spine_dir}/autopilot-ledger.md",
    "clearing": ["rerun-check", "remove-file"],
    "resume_to": { "correct": ["reclose"] }
  },
  "stages": {
    "lane": {
      "kind": "session",
      "instance": "OMP_Seat",
      "model": "default",
      "project": "{param.ai_project}",
      "cwd": "{param.ai_root}",
      "launch_dir": "root",
      "title": "lane {param.spine}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/lane.md, and follow them. Spine: {param.spine}. Queue directory: {run.dir}/queue. OUT: {run.dir}/out/{unit.id}. Lane done file: {run.dir}/out/{unit.id}/lane.done. Rounds done file: {run.dir}/rounds.done. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "coordinator",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
        "OMP_T3_VIA": "{param.via}",
        "OMP_T3_SEAT": "worker",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        {
          "when": [{ "file": "{run.dir}/rounds.done" }],
          "to": "spine_open",
          "run": [["rm", "-f", "{run.dir}/out/{unit.id}/lane.done"]]
        },
        {
          "when": [
            { "file": "{run.dir}/out/{unit.id}/lane.done" },
            { "units": { "group": "{run.group}", "stages": ["implement", "gap_wait", "regap", "close", "correct", "reclose", "land"], "count": "none" } }
          ],
          "to": "park",
          "run": [["rm", "-f", "{run.dir}/out/{unit.id}/lane.done"]]
        },
        {
          "when": [{ "file": "{run.dir}/out/{unit.id}/lane.done" }],
          "to": "lane_wait",
          "run": [["rm", "-f", "{run.dir}/out/{unit.id}/lane.done"]]
        }
      ]
    },
    "lane_wait": {
      "kind": "wait",
      "outcomes": [
        { "when": [{ "units": { "group": "{run.group}", "stages": ["done"], "count": "all" } }], "to": "lane" }
      ]
    },
    "implement": {
      "kind": "session",
      "instance": "OMP_Seat",
      "model": "default",
      "project": "{param.project}",
      "cwd": "{unit.vars.worktree_path}",
      "launch_dir": "worktree",
      "title": "implement {unit.id}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/implement.md, and follow them. Work item: {unit.id}. Handoff: {unit.vars.handoff_path}. Report: {param.spine_dir}/work-{unit.id}/report.md. OUT: {run.dir}/out/{unit.id}. Gaps file: {run.dir}/out/{unit.id}/gaps.json. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "implementer",
        "SEAT_MODS_ALLOW": "{param.spine_dir}/work-{unit.id}:{run.dir}/out/{unit.id}",
        "OMP_T3_VIA": "{param.via}",
        "OMP_T3_SEAT": "worker",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session", "build"],
      "before": [
        ["mkdir", "-p", "{run.dir}/out/{unit.id}"],
        ["jq", "-e", "--arg", "w", "{unit.id}", "any(.work_items[]; .id == $w and (.dispatches // 0) < 3)", "{param.state_file}"], ["rm", "-f", "{run.dir}/out/{unit.id}/gaps.json"]
      ],
      "after_launch": [["env", "-C", "{param.ai_root}", "{param.oss}", "work_item_dispatched", "{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        { "when": [{ "file": "{param.spine_dir}/work-{unit.id}/report.md" }], "to": "close" },
        { "when": [{ "file": "{run.dir}/out/{unit.id}/gaps.json" }], "to": "gap_wait" }
      ]
    },
    "gap_wait": {
      "kind": "wait",
      "outcomes": [
        {
          "when": [
            { "active": "none-in-group" },
            { "units": { "group": "{run.group}", "stages": ["implement", "regap", "correct", "reclose"], "count": "none" } }
          ],
          "to": "regap"
        }
      ]
    },
    "regap": {
      "kind": "session",
      "instance": "OMP_Seat",
      "model": "default",
      "project": "{param.ai_project}",
      "cwd": "{param.ai_root}",
      "launch_dir": "root",
      "title": "regap {unit.id}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/regap.md, and follow them. Spine: {param.spine}. Work item: {unit.id}. Gaps record: {run.dir}/out/{unit.id}/gaps.json. Request record to rewrite: {run.dir}/queue/{unit.id}.json. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "coordinator",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
        "OMP_T3_VIA": "{param.via}",
        "OMP_T3_SEAT": "worker",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        { "when": [{ "record_changed": true }], "to": "implement" }
      ]
    },
    "close": {
      "kind": "session",
      "instance": "OMP_Seat",
      "model": "default",
      "project": "{param.ai_project}",
      "cwd": "{param.ai_root}",
      "launch_dir": "root", "title": "close {unit.id}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/close.md, and follow them. Work item: {unit.id}. Handoff: {unit.vars.handoff_path}. Worktree: {unit.vars.worktree_path}. Branch: {unit.vars.branch}. Base SHA: {unit.vars.base_sha}. Correction packet: {run.dir}/out/{unit.id}/correction.txt. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "implementer",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
        "OMP_T3_VIA": "{param.via}",
        "OMP_T3_SEAT": "worker",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        {
          "when": [{ "exit0": ["jq", "-e", "--arg", "w", "{unit.id}", "any(.work_items[]; .id == $w and (.pr_url | type) == \"string\")", "{param.state_file}"] }],
          "to": "land"
        },
        {
          "when": [{ "file": "{run.dir}/out/{unit.id}/correction.txt" }],
          "to": "correct"
        }
      ]
    },
    "correct": {
      "kind": "session",
      "instance": "OMP_Seat",
      "model": "default",
      "project": "{param.project}",
      "cwd": "{unit.vars.worktree_path}",
      "launch_dir": "worktree",
      "title": "correct {unit.id}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/correct.md, and follow them. Work item: {unit.id}. Handoff: {unit.vars.handoff_path}. Correction packet: {run.dir}/out/{unit.id}/correction.txt. Corrected file: {run.dir}/out/{unit.id}/corrected. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "implementer",
        "SEAT_MODS_ALLOW": "{param.spine_dir}/work-{unit.id}:{run.dir}/out/{unit.id}",
        "OMP_T3_VIA": "{param.via}",
        "OMP_T3_SEAT": "worker",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session", "build"],
      "before": [
        ["mkdir", "-p", "{run.dir}/out/{unit.id}"],
        ["jq", "-e", "--arg", "w", "{unit.id}", "any(.work_items[]; .id == $w and (.dispatches // 0) < 3)", "{param.state_file}"], ["rm", "-f", "{run.dir}/out/{unit.id}/corrected"]
      ],
      "after_launch": [["env", "-C", "{param.ai_root}", "{param.oss}", "work_item_dispatched", "{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        {
          "when": [{ "file": "{run.dir}/out/{unit.id}/corrected" }],
          "to": "reclose",
          "run": [["rm", "-f", "{run.dir}/out/{unit.id}/corrected", "{run.dir}/out/{unit.id}/correction.txt"]]
        }
      ]
    },
    "reclose": {
      "kind": "session",
      "instance": "OMP_Seat",
      "model": "default",
      "project": "{param.ai_project}",
      "cwd": "{param.ai_root}",
      "launch_dir": "root", "title": "reclose {unit.id}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/close.md, and follow them. Work item: {unit.id}. Handoff: {unit.vars.handoff_path}. Worktree: {unit.vars.worktree_path}. Branch: {unit.vars.branch}. Base SHA: {unit.vars.base_sha}. Correction packet: {run.dir}/out/{unit.id}/correction.txt. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "implementer",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
        "OMP_T3_VIA": "{param.via}",
        "OMP_T3_SEAT": "worker",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        {
          "when": [{ "exit0": ["jq", "-e", "--arg", "w", "{unit.id}", "any(.work_items[]; .id == $w and (.pr_url | type) == \"string\")", "{param.state_file}"] }],
          "to": "land"
        },
        {
          "when": [{ "file": "{run.dir}/out/{unit.id}/correction.txt" }],
          "to": "correct"
        }
      ]
    },
    "land": {
      "kind": "merge",
      "pr": ["env", "-C", "{param.ai_root}", "{param.oss}", "get", ".work_items[] | select(.id == \"{unit.id}\") | .pr_url"],
      "base": "{param.spine_branch}",
      "repo": "{param.repo}",
      "ordered": true,
      "checks": "green",
      "outcomes": { "merged": "done", "red": "park", "conflict": "park" },
      "run_after": [
        ["sh", "-c", "test \"$(git -C \"$1\" symbolic-ref --short HEAD)\" = \"$2\"", "sh", "{param.repo}", "{param.spine_branch}"],
        ["git", "-C", "{param.repo}", "merge", "--ff-only", "origin/{param.spine_branch}"],
        ["git", "-C", "{param.repo}", "merge-base", "--is-ancestor", "{pr.head}", "{param.spine_branch}"],
        ["env", "-C", "{param.ai_root}", "{param.oss}", "work_item_status", "{unit.id}", "complete"]
      ]
    },
    "spine_open": {
      "kind": "session",
      "instance": "OMP_Seat",
      "model": "default",
      "project": "{param.ai_project}",
      "cwd": "{param.ai_root}",
      "launch_dir": "root",
      "title": "spine open {param.spine}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/spine-open.md, and follow them. Spine: {param.spine}. Spine PR record: {run.dir}/spine/spine-pr.json. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "coordinator",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
        "OMP_T3_VIA": "{param.via}",
        "OMP_T3_SEAT": "worker",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        { "when": [{ "file": "{run.dir}/spine/spine-pr.json" }], "to": "done" }
      ]
    },
    "spine_review": {
      "kind": "session",
      "instance": "OMP_Seat",
      "model": "default",
      "project": "{param.project}",
      "cwd": "{param.repo}",
      "launch_dir": "worktree",
      "title": "spine review {param.spine}",
      "message": "/review {unit.vars.pr_url} Then read {param.briefs}/common.md and {param.briefs}/spine-review.md, and write {run.dir}/out/{unit.id}/review.md whose first line is exactly verdict: pass or verdict: block, whose second line is head: followed by the reviewed head SHA, then the findings. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "reviewer",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
        "OMP_T3_VIA": "{param.via}",
        "OMP_T3_SEAT": "worker",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        {
          "when": [
            { "file": "{run.dir}/out/{unit.id}/review.md" },
            { "exit0": ["grep", "-qxE", "verdict: (pass|block)", "{run.dir}/out/{unit.id}/review.md"] }
          ],
          "to": "spine_wait"
        }
      ]
    },
    "spine_wait": {
      "kind": "wait",
      "outcomes": [
        { "when": [{ "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "merged" } }], "to": "spine_finish" },
        { "when": [{ "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "closed" } }], "to": "park" },
        { "when": [{ "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "conflict" } }], "to": "park" },
        { "when": [{ "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "checks_red" } }], "to": "spine_work" },
        {
          "when": [
            { "exit0": ["grep", "-qx", "verdict: block", "{run.dir}/out/{unit.id}/review.md"] },
            { "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "checks_green" } }
          ],
          "to": "spine_work"
        },
        {
          "when": [
            { "exit0": ["grep", "-qx", "verdict: pass", "{run.dir}/out/{unit.id}/review.md"] },
            { "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "checks_green" } },
            { "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "mergeable" } }
          ],
          "to": "spine_ack",
          "notify": "Spine {param.spine} PR {unit.vars.pr_url} passed review and is green and mergeable: read its needs-you list and any CodeRabbit thread newer than the last push, then merge it (the phone's Merge button, or by hand)."
        }
      ]
    },
    "spine_work": {
      "kind": "session",
      "instance": "OMP_Seat",
      "model": "default",
      "project": "{param.project}",
      "cwd": "{param.repo}",
      "launch_dir": "root",
      "title": "spine work {param.spine}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/spine-work.md, and follow them. Spine PR: {unit.vars.pr_url}. Review: {run.dir}/out/{unit.id}/review.md. Operator file: {run.dir}/out/{unit.id}/operator.md. Round done file: {run.dir}/out/{unit.id}/round-done. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "implementer",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}:{param.spine_dir}",
        "OMP_T3_VIA": "{param.via}",
        "OMP_T3_SEAT": "worker",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        {
          "when": [{ "file": "{run.dir}/out/{unit.id}/round-done" }],
          "to": "spine_review",
          "run": [["rm", "-f", "{run.dir}/out/{unit.id}/review.md", "{run.dir}/out/{unit.id}/round-done", "{run.dir}/out/{unit.id}/operator.md"]]
        }
      ]
    },
    "spine_ack": {
      "kind": "wait",
      "outcomes": [
        { "when": [{ "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "merged" } }], "to": "spine_finish" },
        { "when": [{ "pr": { "url": ["printf", "%s", "{unit.vars.pr_url}"], "test": "closed" } }], "to": "park" }
      ]
    },
    "spine_finish": {
      "kind": "session",
      "instance": "OMP_Seat",
      "model": "default",
      "project": "{param.ai_project}",
      "cwd": "{param.ai_root}",
      "launch_dir": "root",
      "title": "spine finish {param.spine}",
      "message": "Read {param.briefs}/common.md, then {param.briefs}/spine-finish.md, and follow them. Spine: {param.spine}. Spine PR: {unit.vars.pr_url}. OUT: {run.dir}/out/{unit.id}. Stop file: {run.dir}/out/{unit.id}/stop. Ledger: {param.spine_dir}/autopilot-ledger.md.",
      "env": {
        "SEAT_MODS_ROLE": "coordinator",
        "SEAT_MODS_ALLOW": "{run.dir}/out/{unit.id}",
        "OMP_T3_VIA": "{param.via}",
        "OMP_T3_SEAT": "worker",
        "MOLT_HANDOFF": "parent",
        "MOLT_STATUS_PATH": "{run.dir}/out/{unit.id}/molt.log",
        "SPINE_LEDGER": "{param.spine_dir}/autopilot-ledger.md",
        "SPINE_STOP_FILE": "{run.dir}/out/{unit.id}/stop"
      },
      "slots": ["session"],
      "before": [["mkdir", "-p", "{run.dir}/out/{unit.id}"]],
      "stop_file": "{run.dir}/out/{unit.id}/stop",
      "handoff": { "file": "{run.dir}/out/{unit.id}/molt.log", "token": "handed-off", "message": "Continue from the handoff at {handoff_path}. Then read the brief named in it and finish the stage." },
      "outcomes": [
        {
          "when": [{ "exit0": ["jq", "-e", "--arg", "s", "{param.spine}", ".spines[] | select(.id == $s) | .status == \"closed\"", "{param.state_file}"] }],
          "to": "done"
        }
      ]
    }
  }
}
