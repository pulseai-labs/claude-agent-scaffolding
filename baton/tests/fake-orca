#!/usr/bin/env bun
// A stand-in for the `orca` CLI. FAKE_ORCA_DIR/replies.json maps a subcommand ("terminal create")
// to a fixture file name, or a list of names used in order (the last repeats). A name is looked up
// in FAKE_ORCA_DIR first, then in tests/fixtures/orca. Every argv is appended to argv.jsonl.
// FAKE_ORCA_HANG=1 sleeps 60 s; FAKE_ORCA_GARBAGE=1 prints "not json".
import { appendFileSync, existsSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const dir = process.env.FAKE_ORCA_DIR!;
const argv = process.argv.slice(2);
appendFileSync(join(dir, "argv.jsonl"), JSON.stringify(argv) + "\n");
if (process.env.FAKE_ORCA_HANG) await Bun.sleep(60_000);
if (process.env.FAKE_ORCA_GARBAGE) {
  console.log("not json");
  process.exit(0);
}
const key = argv.slice(0, 2).join(" ");
const replies = JSON.parse(readFileSync(join(dir, "replies.json"), "utf8")) as Record<string, string | string[]>;
const entry = replies[key];
if (entry === undefined) {
  console.error(`fake-orca: no reply for "${key}"`);
  process.exit(2);
}
let name: string;
if (Array.isArray(entry)) {
  const counts = join(dir, "counts.json");
  const seen: Record<string, number> = existsSync(counts) ? JSON.parse(readFileSync(counts, "utf8")) : {};
  const n = seen[key] ?? 0;
  seen[key] = n + 1;
  writeFileSync(counts, JSON.stringify(seen));
  name = entry[Math.min(n, entry.length - 1)];
} else name = entry;
const own = join(dir, name);
const path = existsSync(own) ? own : join(import.meta.dir, "fixtures", "orca", name);
process.stdout.write(readFileSync(path, "utf8"));
// All Orca error replies exit 1; the envelope, not the exit code, is what matters.
process.exit(JSON.parse(readFileSync(path, "utf8")).ok === false ? 1 : 0);
