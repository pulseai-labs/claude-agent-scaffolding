// templates/pairing.json.tmpl — REFERENCE-ONLY (not rendered)
//
// IMPLEMENTATION NOTE
// -------------------
// The actual pairing.json manifest is generated by `wi_manifest_write` in
// lib/manifest.sh using `jq -n` with --arg / --argjson, NOT by passing this
// file through `wi_render_template`. Reasons:
//
//   1. Structured JSON is safer to construct with jq than with string
//      substitution (correct quoting, escape handling, null vs "null").
//   2. The manifest body contains literal `${ai_workspace.root}` and
//      `${canonical.root}` references that are meant to be resolved at READ
//      time by `wi_manifest_resolve` — not at WRITE time. A string-substitution
//      template renderer would clobber those.
//
// This file is preserved as a human-readable reference for the v1.0 manifest
// shape, mirroring SPEC §6.2 verbatim. If the schema needs to change, update
// BOTH this reference AND the `jq -n` payload in `wi_manifest_write`.
//
// Substitution points used by `wi_manifest_write` (NOT done via wi_render_template):
//   ${SCHEMA_VERSION}            — always "1.0"
//   ${AI_WORKSPACE_ROOT}         — absolute path
//   ${AI_WORKSPACE_NAME}         — basename of AI workspace root
//   ${AI_WORKSPACE_GIT_TRACKED}  — always true
//   ${AI_WORKSPACE_GIT_REMOTE}   — null or "<url>"
//   ${CANONICAL_ROOT}            — absolute path
//   ${CANONICAL_NAME}            — basename
//   ${CANONICAL_GIT_TRACKED}     — always true
//   ${CANONICAL_GIT_REMOTE}      — null or "<url>"
//   ${CANONICAL_DEFAULT_BRANCH}  — e.g. "main"
//   ${TOOLING_REPO}              — OPTIONAL (#48 Stage 2). When --tooling-repo is
//                                  passed to wi_manifest_write, a tooling_repo
//                                  object { root, name, git_remote } is emitted
//                                  right after `canonical` (mirroring its
//                                  sub-schema); name = basename of the root,
//                                  git_remote = null or the --tooling-repo-remote
//                                  URL. Absent by default → the key is omitted
//                                  entirely (NOT null) and behavior is unchanged.
//                                  Routes `/defer --tooling` to a tooling repo.
//   ${PROJECT_TYPE}              — "personal" or "work"
//   ${CREATED_AT}                — ISO 8601 (e.g. 2026-05-25T14:30:00Z)
//   ${CREATED_BY}                — "workspace-init@<running plugin version>"
//
// See: workspace-init/docs/SPEC §6.2 for the canonical schema and §6.3 for the
// ${ai_workspace.root} / ${canonical.root} / ${PLUGIN_DATA:<name>} / ${HOME} /
// ${USER} resolver semantics.

{
  "schema_version": "${SCHEMA_VERSION}",
  "topology": "dual-repo",

  "ai_workspace": {
    "root": "${AI_WORKSPACE_ROOT}",
    "name": "${AI_WORKSPACE_NAME}",
    "git_tracked": ${AI_WORKSPACE_GIT_TRACKED},
    "git_remote": ${AI_WORKSPACE_GIT_REMOTE}
  },
  "canonical": {
    "root": "${CANONICAL_ROOT}",
    "name": "${CANONICAL_NAME}",
    "git_tracked": ${CANONICAL_GIT_TRACKED},
    "git_remote": ${CANONICAL_GIT_REMOTE},
    "default_branch": "${CANONICAL_DEFAULT_BRANCH}"
  },

  // OPTIONAL (#48 Stage 2) — present only when wi_manifest_write is given
  // --tooling-repo. Mirrors canonical's sub-schema; routes `/defer --tooling`.
  // Omit the whole key when there is no tooling repo (do NOT write null).
  // "tooling_repo": {
  //   "root": "${TOOLING_REPO_ROOT}",
  //   "name": "${TOOLING_REPO_NAME}",
  //   "git_remote": ${TOOLING_REPO_GIT_REMOTE}
  // },

  "routing": {
    "master_spec":              "ai_workspace",
    "executive_summary":        "canonical",
    "memory_bank":              "ai_workspace",
    "claude_md":                "ai_workspace",
    "agents_md":                "ai_workspace",
    "scaffold_project_outputs": "ai_workspace",
    "backlog":                  "canonical",
    "project_plan":             "canonical",
    "roadmap":                  "canonical",
    "prd":                      "canonical",
    "srs":                      "canonical",
    "product_adrs":             "canonical",
    "process_adrs":             "ai_workspace",
    "sprint_specs":             "ai_workspace",
    "implementation_handoffs":  "ai_workspace",
    "brainstorm_artifacts":     "ai_workspace"
  },

  "during_dev": {
    "worktrees_dir":        "${canonical.root}/.worktrees",
    "branch_naming":        "slice/sprint-{N}-work-{NN}-{kebab-name}",
    "sprint_dir_template":  "${ai_workspace.root}/docs/specs/sprint-{N}",
    "slice_spec_format":    "wabash-format-b-v1"
  },

  "well_known_paths": {
    "master_spec":            "${ai_workspace.root}/docs/MASTER-SPEC.md",
    "memory_bank":            "${ai_workspace.root}/.claude/memory-bank",
    "superpowers_brainstorm": "${ai_workspace.root}/.superpowers/brainstorm"
  },

  "git_policy": {
    "project_type": "${PROJECT_TYPE}",
    "allow_ai_local_commits": true,
    "allow_ai_local_merge":   true,
    "allow_ai_local_rebase":  true,
    "allow_ai_fetch":         false,
    "allow_ai_push":          false,
    "allow_ai_pull":          false,
    "trace_filter": {
      "enforce": true,
      "blocked_patterns": [
        "^Co-Authored-By:",
        "^🤖 Generated with",
        "<noreply@anthropic\\.com>",
        "<noreply@openai\\.com>"
      ]
    }
  },

  "created_at": "${CREATED_AT}",
  "created_by": "${CREATED_BY}"
}
