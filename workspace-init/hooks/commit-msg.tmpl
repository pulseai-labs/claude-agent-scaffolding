#!/usr/bin/env bash
# workspace-init: commit-msg AI-trace filter (auto-installed)
# workspace-init:managed-hook
# DO NOT EDIT — regenerated on workspace-init runs.
# Embedded AI workspace path: __AI_WORKSPACE_PATH__
# Embedded wi dispatcher path: __WI_BIN_PATH__

# The AI workspace path and wi dispatcher path are baked in shell-quoted form
# at install time, so any character (" $ ` ' & | \ space …) arrives literally.
AI_WORKSPACE_PATH=__AI_WORKSPACE_PATH__
WI_BIN=__WI_BIN_PATH__
MANIFEST_PATH="${AI_WORKSPACE_PATH}/.workspace/pairing.json"

commit_msg_file="$1"
if [[ ! -f "$commit_msg_file" ]]; then exit 0; fi

# The filter exists to keep AI traces out of public canonical history: a leak
# is permanent while a blocked commit costs one repair command. When it cannot
# evaluate its policy — manifest missing, malformed, or incomplete — it fails
# CLOSED and names the working repair (#458, #481).

# The main worktree root of the repo this hook guards. `git rev-parse
# --git-common-dir` resolves to the main worktree's .git even when the hook
# runs inside a linked worktree (the hook file lives in the common hooks dir);
# the dirname fallback reaches the same place via the hook's own path.
_wi_main_worktree_root() {
  local common
  common="$(git rev-parse --git-common-dir 2>/dev/null)" || common=""
  [[ -n "$common" ]] || common="$(dirname "$0")/.."
  ( cd "$common/.." 2>/dev/null && pwd -P )
}

# Every repair line names a real wi verb with %q-quoted absolute paths, so it
# can be typed verbatim. Which repair fixes the failure depends on whether the
# baked workspace path still exists, so the hint branches on that.
_wi_repair_hint() {
  local canon q_ai q_canon q_wi
  canon="$(_wi_main_worktree_root)"
  [[ -n "$canon" ]] || canon="$(pwd -P 2>/dev/null)" || canon="."
  printf -v q_ai '%q' "$AI_WORKSPACE_PATH"
  printf -v q_canon '%q' "$canon"
  printf -v q_wi '%q' "$WI_BIN"
  if [[ -d "$AI_WORKSPACE_PATH" ]]; then
    echo "       Repair — rewrite the manifest, then re-bake the hooks:" >&2
    echo "         $q_wi manifest_write $q_ai $q_canon personal   # project_type: personal or work" >&2
    echo "         $q_wi trace_filter_install_pair $q_ai $q_canon" >&2
    echo "         (or $q_wi trace_filter_install $q_ai $q_canon to repair only this repo's hook)" >&2
  else
    echo "       Repair — the baked path does not exist; the workspace may have moved." >&2
    echo "       Run from the workspace's NEW parent directory:" >&2
    echo "         $q_wi trace_filter_install_pair <new-ai-root> $q_canon" >&2
    echo "         (or $q_wi trace_filter_install <new-ai-root> $q_canon to repair only this repo's hook)" >&2
  fi
}

# jq evaluates every policy check below; without it none of them can run.
# Detect it explicitly so the failure names the actual missing tool rather
# than surfacing as a JSON parse error.
if ! command -v jq >/dev/null 2>&1; then
  echo "ERROR: workspace-init trace filter: jq is missing (not installed or not on PATH); the manifest cannot be evaluated; commit blocked." >&2
  echo "       Repair: install jq (e.g. apt-get install jq, brew install jq), then retry." >&2
  exit 1
fi

# Baked AI workspace path unreachable (workspace moved/deleted) → block,
# naming the path itself rather than a JSON error.
if [[ ! -d "$AI_WORKSPACE_PATH" ]]; then
  echo "ERROR: workspace-init trace filter: AI workspace path is unreachable: $AI_WORKSPACE_PATH; commit blocked." >&2
  _wi_repair_hint
  exit 1
fi

# Missing manifest → block.
if [[ ! -f "$MANIFEST_PATH" ]]; then
  echo "ERROR: workspace-init trace filter: manifest not found at $MANIFEST_PATH; commit blocked." >&2
  _wi_repair_hint
  exit 1
fi

# Malformed manifest → block. `jq empty` is not sufficient: jq accepts a
# STREAM of inputs, so an empty file, whitespace-only file, or two
# concatenated documents all pass it. Require exactly one JSON object.
if ! jq -ne 'input as $doc | ([inputs] | length == 0) and ($doc | type == "object")' "$MANIFEST_PATH" >/dev/null 2>&1; then
  echo "ERROR: workspace-init trace filter: manifest at $MANIFEST_PATH is not a single JSON object; commit blocked." >&2
  _wi_repair_hint
  exit 1
fi

# Only an explicit `enforce: false` disables the filter. Every manifest written
# by wi_manifest_write carries the key; a missing or non-boolean value means a
# corrupt manifest → block.
if ! enforce="$(jq -r '.git_policy.trace_filter.enforce | if type == "boolean" then . else error("enforce is not a boolean") end' "$MANIFEST_PATH" 2>/dev/null)"; then
  echo "ERROR: workspace-init trace filter: git_policy.trace_filter.enforce missing or not a boolean in $MANIFEST_PATH; commit blocked." >&2
  _wi_repair_hint
  exit 1
fi
if [[ "$enforce" != "true" ]]; then exit 0; fi

# enforce:true but unreadable patterns (missing key, non-array, or non-string
# elements) → block. An explicit empty array is a deliberate allow-everything
# and still exits 0.
if ! patterns="$(jq -r '.git_policy.trace_filter.blocked_patterns | if type == "array" then (if ([.[] | type == "string"] | all) then .[] else error("blocked_patterns contains non-string entries") end) else error("blocked_patterns is not an array") end' "$MANIFEST_PATH" 2>/dev/null)"; then
  echo "ERROR: workspace-init trace filter: cannot read git_policy.trace_filter.blocked_patterns in $MANIFEST_PATH; commit blocked." >&2
  _wi_repair_hint
  exit 1
fi
if [[ -z "$patterns" ]]; then exit 0; fi

# Scan commit message against each pattern. grep exit status 2 is an ERE
# evaluation error, NOT "no match" — a pattern the filter cannot apply is a
# broken policy, and a broken policy fails closed (naming the pattern).
while IFS= read -r pattern; do
  [[ -z "$pattern" ]] && continue
  if grep -qE -e "$pattern" -- "$commit_msg_file"; then
    echo "ERROR: commit message contains blocked AI-trace pattern: $pattern" >&2
    echo "       Edit the message and try again, or run with --no-verify to bypass (not recommended)." >&2
    exit 1
  else
    grc=$?
    if [[ $grc -ne 1 ]]; then
      echo "ERROR: workspace-init trace filter: blocked_patterns entry is not a valid extended regex: $pattern" >&2
      echo "       Fix or remove the pattern in $MANIFEST_PATH." >&2
      _wi_repair_hint
      exit 1
    fi
  fi
done <<< "$patterns"

exit 0
