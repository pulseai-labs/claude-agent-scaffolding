#!/usr/bin/env bash
# workspace-init: commit-msg AI-trace filter (auto-installed)
# workspace-init:managed-hook
# DO NOT EDIT — regenerated on workspace-init runs.
# Embedded AI workspace path: __AI_WORKSPACE_PATH__

# The AI workspace path is baked in shell-quoted form at install time, so any
# character in the path (" $ ` ' & | \ space …) arrives here literally.
AI_WORKSPACE_PATH=__AI_WORKSPACE_PATH__
MANIFEST_PATH="${AI_WORKSPACE_PATH}/.workspace/pairing.json"

commit_msg_file="$1"
if [[ ! -f "$commit_msg_file" ]]; then exit 0; fi

# The filter exists to keep AI traces out of public canonical history: a leak
# is permanent while a blocked commit costs one repair command. When it cannot
# evaluate its policy — manifest missing, malformed, or incomplete — it fails
# CLOSED and names the working repair (#458, #481).
_wi_repair_hint() {
  local repo
  repo="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  echo "       Repair: <workspace-init plugin dir>/bin/wi trace_filter_install_pair <ai-workspace> $repo" >&2
  echo "               (single repo: .../bin/wi trace_filter_install <ai-workspace> $repo if the AI" >&2
  echo "                workspace is not a git repo; if the workspace moved, pass its NEW path.)" >&2
  echo "               Plugin dir e.g. ~/.claude/plugins/cache/<marketplace>/workspace-init/<version>" >&2
  echo "               or ~/.codex/plugins/cache/<marketplace>/workspace-init/<version>." >&2
}

# Missing manifest (AI workspace moved/deleted) → block.
if [[ ! -f "$MANIFEST_PATH" ]]; then
  echo "ERROR: workspace-init trace filter: manifest not found at $MANIFEST_PATH; commit blocked." >&2
  _wi_repair_hint
  exit 1
fi

# Malformed manifest → block. `jq empty` is not sufficient: jq accepts a
# STREAM of inputs, so an empty file, whitespace-only file, or two
# concatenated documents all pass it. Require exactly one JSON object.
if ! jq -ne 'input as $doc | ([inputs] | length == 0) and ($doc | type == "object")' "$MANIFEST_PATH" >/dev/null 2>&1; then
  echo "ERROR: workspace-init trace filter: manifest at $MANIFEST_PATH is not a single JSON object; commit blocked." >&2
  _wi_repair_hint
  exit 1
fi

# Only an explicit `enforce: false` disables the filter. Every manifest written
# by wi_manifest_write carries the key; a missing or non-boolean value means a
# corrupt manifest → block.
if ! enforce="$(jq -r '.git_policy.trace_filter.enforce | if type == "boolean" then . else error("enforce is not a boolean") end' "$MANIFEST_PATH" 2>/dev/null)"; then
  echo "ERROR: workspace-init trace filter: git_policy.trace_filter.enforce missing or not a boolean in $MANIFEST_PATH; commit blocked." >&2
  _wi_repair_hint
  exit 1
fi
if [[ "$enforce" != "true" ]]; then exit 0; fi

# enforce:true but unreadable patterns (missing key or non-array) → block.
# An explicit empty array is a deliberate allow-everything and still exits 0.
if ! patterns="$(jq -r '.git_policy.trace_filter.blocked_patterns | if type == "array" then .[] else error("blocked_patterns is not an array") end' "$MANIFEST_PATH" 2>/dev/null)"; then
  echo "ERROR: workspace-init trace filter: cannot read git_policy.trace_filter.blocked_patterns in $MANIFEST_PATH; commit blocked." >&2
  _wi_repair_hint
  exit 1
fi
if [[ -z "$patterns" ]]; then exit 0; fi

# Scan commit message against each pattern
while IFS= read -r pattern; do
  [[ -z "$pattern" ]] && continue
  if grep -qE "$pattern" "$commit_msg_file"; then
    echo "ERROR: commit message contains blocked AI-trace pattern: $pattern" >&2
    echo "       Edit the message and try again, or run with --no-verify to bypass (not recommended)." >&2
    exit 1
  fi
done <<< "$patterns"

exit 0
