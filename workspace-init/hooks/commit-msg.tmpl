#!/usr/bin/env bash
# workspace-init: commit-msg AI-trace filter (auto-installed)
# workspace-init:managed-hook
# DO NOT EDIT — regenerated on workspace-init runs.
# AI workspace reference: __AI_WORKSPACE_REF__

# Where the AI workspace is, baked shell-quoted at install time in one of three
# forms, so any character in a name or path arrives here literally (#983):
#   self           this repo is the AI workspace
#   sibling:<dir>  the AI workspace is <dir> beside this repo's main worktree
#   abs:<path>     a fixed absolute path (a pair that is neither; host-bound)
# self and sibling are resolved from the repo this hook runs in, so the hook
# keeps working when both repos sit side by side under another parent on
# another host. They are baked only when the install target's .git is a
# directory, which is what lets the parent of the common git dir name it.
AI_WORKSPACE_REF=__AI_WORKSPACE_REF__

commit_msg_file="$1"
if [[ ! -f "$commit_msg_file" ]]; then exit 0; fi

# The filter exists to keep AI traces out of public canonical history: a leak
# is permanent while a blocked commit costs one repair command. When it cannot
# evaluate its policy — manifest missing, malformed, or incomplete — it fails
# CLOSED and states the reason (#458, #481). Repairs are prose, not computed
# paths: see the Repair section of the workspace-init README.
_wi_block() {
  echo "       See Repair in the workspace-init README. To commit before repairing, name the manifest for one commit: WI_TRACE_FILTER_MANIFEST=<ai-workspace>/.workspace/pairing.json git commit ..." >&2
  exit 1
}

# jq evaluates every policy check below; without it none of them can run.
# Detect it explicitly so the failure names the actual missing tool rather
# than surfacing as a JSON parse error.
if ! command -v jq >/dev/null 2>&1; then
  echo "ERROR: workspace-init trace filter fails closed: jq is not installed or not on PATH; the manifest cannot be evaluated; commit blocked." >&2
  _wi_block
fi

# WI_TRACE_FILTER_MANIFEST names the manifest for this commit, in place of the
# baked reference: the escape for a workspace that moved, which keeps the
# filter running where --no-verify would switch it off. It is announced, so an
# override left set in a shell is never silent.
if [[ -n "${WI_TRACE_FILTER_MANIFEST:-}" ]]; then
  MANIFEST_PATH="$WI_TRACE_FILTER_MANIFEST"
  echo "note: workspace-init trace filter reads the manifest named by WI_TRACE_FILTER_MANIFEST: $MANIFEST_PATH" >&2
else
  case "$AI_WORKSPACE_REF" in
    self|sibling:*)
      # The main worktree is the parent of the common git dir, from a linked
      # worktree as well; a common dir not named .git has no such parent.
      repo_root=""
      if common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" \
          && common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P)" \
          && [[ "${common_dir##*/}" == ".git" ]]; then
        repo_root="${common_dir%/.git}"
      fi
      if [[ -z "$repo_root" ]]; then
        echo "ERROR: workspace-init trace filter fails closed: cannot locate this repository's main worktree to resolve the AI workspace ($AI_WORKSPACE_REF); commit blocked." >&2
        _wi_block
      fi
      if [[ "$AI_WORKSPACE_REF" == self ]]; then
        AI_WORKSPACE_PATH="$repo_root"
      else
        AI_WORKSPACE_PATH="${repo_root%/*}/${AI_WORKSPACE_REF#sibling:}"
      fi
      ;;
    abs:*)
      AI_WORKSPACE_PATH="${AI_WORKSPACE_REF#abs:}"
      ;;
    *)
      echo "ERROR: workspace-init trace filter fails closed: unrecognised AI workspace reference: $AI_WORKSPACE_REF; commit blocked." >&2
      _wi_block
      ;;
  esac
  MANIFEST_PATH="${AI_WORKSPACE_PATH}/.workspace/pairing.json"

  # Resolved AI workspace unreachable (workspace moved/deleted) → block,
  # naming the path itself rather than a JSON error.
  if [[ ! -d "$AI_WORKSPACE_PATH" ]]; then
    echo "ERROR: workspace-init trace filter fails closed: AI workspace path is unreachable: $AI_WORKSPACE_PATH; commit blocked." >&2
    _wi_block
  fi
fi

# Missing manifest → block.
if [[ ! -f "$MANIFEST_PATH" ]]; then
  echo "ERROR: workspace-init trace filter fails closed: manifest not found at $MANIFEST_PATH; commit blocked." >&2
  _wi_block
fi

# Malformed manifest → block. `jq empty` is not sufficient: jq accepts a
# STREAM of inputs, so an empty file, whitespace-only file, or two
# concatenated documents all pass it. Require exactly one JSON object.
if ! jq -ne 'input as $doc | ([inputs] | length == 0) and ($doc | type == "object")' "$MANIFEST_PATH" >/dev/null 2>&1; then
  echo "ERROR: workspace-init trace filter fails closed: manifest at $MANIFEST_PATH is not a single JSON object; commit blocked." >&2
  _wi_block
fi

# Only an explicit `enforce: false` disables the filter. Every manifest written
# by wi_manifest_write carries the key; a missing or non-boolean value means a
# corrupt manifest → block.
if ! enforce="$(jq -r '.git_policy.trace_filter.enforce | if type == "boolean" then . else error("enforce is not a boolean") end' "$MANIFEST_PATH" 2>/dev/null)"; then
  echo "ERROR: workspace-init trace filter fails closed: git_policy.trace_filter.enforce missing or not a boolean in $MANIFEST_PATH; commit blocked." >&2
  _wi_block
fi
if [[ "$enforce" != "true" ]]; then exit 0; fi

# enforce:true but unreadable patterns (missing key, non-array, or non-string
# elements) → block. An explicit empty array is a deliberate allow-everything
# and still exits 0.
if ! patterns="$(jq -r '.git_policy.trace_filter.blocked_patterns | if type == "array" then (if ([.[] | type == "string"] | all) then .[] else error("blocked_patterns contains non-string entries") end) else error("blocked_patterns is not an array") end' "$MANIFEST_PATH" 2>/dev/null)"; then
  echo "ERROR: workspace-init trace filter fails closed: cannot read git_policy.trace_filter.blocked_patterns in $MANIFEST_PATH; commit blocked." >&2
  _wi_block
fi
# An empty-string entry has no coherent meaning: as an extended regex it
# matches every message, yet the scan below cannot apply it, so it used to be
# skipped and read as allow-all (#493). An entry containing a line break (or a
# NUL) collapses the same way: the patterns travel one per line, so "\n" turns
# into empty records the scan skips. Both are broken policy, and a broken
# policy fails closed. To allow everything, use an empty array or enforce:false.
if jq -e '.git_policy.trace_filter.blocked_patterns | any(. == "" or (explode | any(. == 10 or . == 0)))' "$MANIFEST_PATH" >/dev/null 2>&1; then
  echo "ERROR: workspace-init trace filter fails closed: git_policy.trace_filter.blocked_patterns contains an empty-string entry or an entry with a line break in $MANIFEST_PATH; commit blocked." >&2
  _wi_block
fi
if [[ -z "$patterns" ]]; then exit 0; fi

# Scan commit message against each pattern. grep exit status 2 is an ERE
# evaluation error, NOT "no match" — a pattern the filter cannot apply is a
# broken policy, and a broken policy fails closed (naming the pattern).
while IFS= read -r pattern; do
  [[ -z "$pattern" ]] && continue
  if grep -qE -e "$pattern" -- "$commit_msg_file"; then
    echo "ERROR: commit message contains blocked AI-trace pattern: $pattern" >&2
    echo "       Edit the message and try again, or run with --no-verify to bypass (not recommended)." >&2
    exit 1
  else
    grc=$?
    if [[ $grc -ne 1 ]]; then
      echo "ERROR: workspace-init trace filter fails closed: blocked_patterns entry is not a valid extended regex: $pattern" >&2
      _wi_block
    fi
  fi
done <<< "$patterns"

exit 0
