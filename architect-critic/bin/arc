#!/usr/bin/env bash
# bin/arc — dispatcher entry point for architect-critic
#
# Why "arc" not "ac": macOS ships /usr/sbin/ac (the login accounting utility),
# so a dispatcher named "ac" would shadow or be shadowed depending on PATH
# order. "arc" is short for architect-critic and conflict-free.
#
# Why this exists: Claude Code's Bash tool on macOS runs under zsh by default
# ($SHELL=zsh). Skill bodies that `source lib/*.sh` then inherit zsh, where
# ${BASH_SOURCE[0]} is unset and ${BASH_REMATCH[…]} returns empty silently.
# This dispatcher's shebang (#!/usr/bin/env bash) forces bash via the kernel
# on direct execution, regardless of caller shell. Libs sourced through here
# get the bash runtime they were written for. Also obviates the prior pattern
# `bash -c 'source "${CLAUDE_PLUGIN_ROOT}/lib/X.sh" && ac_fn …'`, which broke
# whenever the upstream CLAUDE_PLUGIN_ROOT env var wasn't exported.
#
# Contract:
#   arc <function-suffix> [args...]
#     → resolves to ac_<function-suffix>, dispatches with remaining args.
#       Examples:
#         arc state_append_run                  → ac_state_append_run
#         arc principles_user_path              → ac_principles_user_path
#   arc --list
#     → prints all ac_-prefixed functions, one per line, sorted.
#
# Note the underscore prefix is `ac_` (matches the existing lib naming
# convention); the command name is `arc` to avoid the /usr/sbin/ac shadow.
#
# Exit codes:
#   0    function ran successfully (or matched function's exit code)
#   2    usage error (no args, unknown function)
#   *    propagated verbatim from the dispatched function
# stdout/stderr are passed through unchanged — no wrapping.

set -euo pipefail

readonly _DISPATCHER_PREFIX="ac"

_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$_BIN_DIR/.." && pwd)"
export PLUGIN_ROOT
_LIB_DIR="$PLUGIN_ROOT/lib"

if [ -f "$_LIB_DIR/_helpers.sh" ]; then
  # shellcheck source=/dev/null
  source "$_LIB_DIR/_helpers.sh"
fi
for _f in "$_LIB_DIR"/*.sh; do
  [ -e "$_f" ] || continue
  [ "$(basename "$_f")" = "_helpers.sh" ] && continue
  # shellcheck source=/dev/null
  source "$_f"
done

if [ "${1:-}" = "--list" ]; then
  declare -F \
    | awk -v pfx="${_DISPATCHER_PREFIX}_" '$3 ~ "^"pfx"[^_]" { sub(pfx, "", $3); print $3 }' \
    | sort
  exit 0
fi

if [ $# -lt 1 ]; then
  cat >&2 <<USAGE
Usage: $(basename "$0") <function-suffix> [args...]
       $(basename "$0") --list

Function suffix resolves to ${_DISPATCHER_PREFIX}_<suffix>.
Examples:
  $(basename "$0") principles_user_path
  $(basename "$0") state_append_run
USAGE
  exit 2
fi

_fn="${_DISPATCHER_PREFIX}_$1"
shift
if ! declare -f "$_fn" >/dev/null 2>&1; then
  echo "Unknown function: $_fn" >&2
  echo "Run '$(basename "$0") --list' to see available functions." >&2
  exit 2
fi
"$_fn" "$@"
